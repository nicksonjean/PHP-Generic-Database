%token precision    (?i)PRECISION(?![a-zA-Z0-9_])
%token money        (?i)MONEY(?![a-zA-Z0-9_])
%token smallmoney   (?i)SMALLMONEY(?![a-zA-Z0-9_])
%token number       (?i)NUMBER(?![a-zA-Z0-9_])

// String types
%token char         (?i)CHAR(?![a-zA-Z0-9_])
%token varchar      (?i)VARCHAR(?![a-zA-Z0-9_])
%token varchar2     (?i)VARCHAR2
%token nchar        (?i)NCHAR(?![a-zA-Z0-9_])

%skip   space           \s
%skip   comment_line    --[^\n]*
%skip   comment_block   /\*(.|\n)*?\*/

// =============================================================================
// STRINGS E DELIMITADORES
// =============================================================================

// strings single quote
%token quote_          '        -> string
%token string:string   [^']+
%token string:_quote   '        -> default

// strings double quote
%token dquote_         "        -> dstring
%token dstring:dstring [^"]+
%token dstring:_dquote "        -> default

// backticks (MySQL)
%token backtick_       `        -> btstring
%token btstring:btstring [^`]+
%token btstring:_backtick `     -> default

// square brackets (SQL Server)
%token lbracket_       \[       -> brstring
%token brstring:brstring [^\]]+
%token brstring:_rbracket \]    -> default

// =============================================================================
// PREFIX PRIORITY TOKENS
// =============================================================================
// These tokens MUST be defined before their shorter prefixes to ensure
// the lexer matches the longest token first.
// Example: INNER must come before IN, otherwise IN matches and NER is left over

// Tokens starting with IN (must come before 'in') - case-insensitive
%token inner        (?i)INNER(?![a-zA-Z0-9_])
%token into         (?i)INTO(?![a-zA-Z0-9_])
%token intersect    (?i)INTERSECT(?![a-zA-Z0-9_])
%token integer      (?i)INTEGER(?![a-zA-Z0-9_])
%token interval     (?i)INTERVAL(?![a-zA-Z0-9_])
%token instead      (?i)INSTEAD(?![a-zA-Z0-9_])
%token inserted     (?i)INSERTED(?![a-zA-Z0-9_])
%token insert       (?i)INSERT(?![a-zA-Z0-9_])
%token invoker      (?i)INVOKER(?![a-zA-Z0-9_])
%token infile       (?i)INFILE(?![a-zA-Z0-9_])
%token inet         (?i)INET(?![a-zA-Z0-9_])
%token info         (?i)INFO(?![a-zA-Z0-9_])
%token index        (?i)INDEX(?![a-zA-Z0-9_])
%token int          (?i)INT(?![a-zA-Z0-9_])
%token in           (?i)IN(?![a-zA-Z0-9_])

// Tokens starting with IS (must come before 'is')
%token isnull       (?i)ISNULL(?![a-zA-Z0-9_])

// =============================================================================
// KEYWORDS - DML (Data Manipulation Language)
// =============================================================================
%token select       (?i)SELECT(?![a-zA-Z0-9_])
// insert moved to PREFIX PRIORITY section
%token update       (?i)UPDATE(?![a-zA-Z0-9_])
%token delete       (?i)DELETE(?![a-zA-Z0-9_])
%token replace      (?i)REPLACE(?![a-zA-Z0-9_])
%token merge        (?i)MERGE(?![a-zA-Z0-9_])
%token upsert       (?i)UPSERT(?![a-zA-Z0-9_])
%token truncate     (?i)TRUNCATE(?![a-zA-Z0-9_])

// =============================================================================
// KEYWORDS - DDL (Data Definition Language)
// =============================================================================
%token create       (?i)CREATE(?![a-zA-Z0-9_])
%token alter        (?i)ALTER(?![a-zA-Z0-9_])
%token drop         (?i)DROP(?![a-zA-Z0-9_])
%token rename       (?i)RENAME(?![a-zA-Z0-9_])

// Object types
%token table        (?i)TABLE(?![a-zA-Z0-9_])
%token column       (?i)COLUMN(?![a-zA-Z0-9_])
// index moved to PREFIX PRIORITY section
%token view         (?i)VIEW(?![a-zA-Z0-9_])
%token database     (?i)DATABASE(?![a-zA-Z0-9_])
%token schema       (?i)SCHEMA(?![a-zA-Z0-9_])
%token sequence     (?i)SEQUENCE(?![a-zA-Z0-9_])
%token trigger      (?i)TRIGGER(?![a-zA-Z0-9_])
%token procedure    (?i)PROCEDURE(?![a-zA-Z0-9_])
%token function     (?i)FUNCTION(?![a-zA-Z0-9_])
%token package      (?i)PACKAGE(?![a-zA-Z0-9_])
%token type         (?i)TYPE(?![a-zA-Z0-9_])
%token domain       (?i)DOMAIN(?![a-zA-Z0-9_])
%token event        (?i)EVENT(?![a-zA-Z0-9_])
%token user         (?i)USER(?![a-zA-Z0-9_])
%token role         (?i)ROLE(?![a-zA-Z0-9_])
%token grant        (?i)GRANT(?![a-zA-Z0-9_])
%token revoke       (?i)REVOKE(?![a-zA-Z0-9_])

// Table/Column modifiers
%token temporary    (?i)TEMPORARY(?![a-zA-Z0-9_])
%token temp         (?i)TEMP(?![a-zA-Z0-9_])
%token global       (?i)GLOBAL(?![a-zA-Z0-9_])
%token local        (?i)LOCAL(?![a-zA-Z0-9_])
%token if           (?i)IF(?![a-zA-Z0-9_])
%token exists       (?i)EXISTS(?![a-zA-Z0-9_])
%token cascade      (?i)CASCADE(?![a-zA-Z0-9_])
%token restrict     (?i)RESTRICT(?![a-zA-Z0-9_])
%token add          (?i)ADD(?![a-zA-Z0-9_])
%token modify       (?i)MODIFY(?![a-zA-Z0-9_])
%token change       (?i)CHANGE(?![a-zA-Z0-9_])

// =============================================================================
// KEYWORDS - CLAUSES
// =============================================================================
%token from         (?i)FROM(?![a-zA-Z0-9_])
// into moved to PREFIX PRIORITY section
%token values       (?i)VALUES(?![a-zA-Z0-9_])
%token set          (?i)SET(?![a-zA-Z0-9_])
%token where        (?i)WHERE(?![a-zA-Z0-9_])
%token group        (?i)GROUP(?![a-zA-Z0-9_])
%token having       (?i)HAVING(?![a-zA-Z0-9_])
%token order        (?i)ORDER(?![a-zA-Z0-9_])
%token limit        (?i)LIMIT(?![a-zA-Z0-9_])
%token offset       (?i)OFFSET(?![a-zA-Z0-9_])
%token fetch        (?i)FETCH(?![a-zA-Z0-9_])
%token first        (?i)FIRST(?![a-zA-Z0-9_])
%token last         (?i)LAST(?![a-zA-Z0-9_])
%token next         (?i)NEXT(?![a-zA-Z0-9_])
%token rows         (?i)ROWS(?![a-zA-Z0-9_])
%token only         (?i)ONLY(?![a-zA-Z0-9_])
%token with         (?i)WITH(?![a-zA-Z0-9_])
%token recursive    (?i)RECURSIVE(?![a-zA-Z0-9_])
%token returns      (?i)RETURNS(?![a-zA-Z0-9_])
%token return       (?i)RETURN(?![a-zA-Z0-9_])
%token returning    (?i)RETURNING(?![a-zA-Z0-9_])

// =============================================================================
// KEYWORDS - MODIFIERS
// =============================================================================
%token distinct     (?i)DISTINCT(?![a-zA-Z0-9_])
%token all          (?i)ALL(?![a-zA-Z0-9_])
%token top          (?i)TOP(?![a-zA-Z0-9_])
%token percent      (?i)PERCENT(?![a-zA-Z0-9_])
%token asc          (?i)ASC(?![a-zA-Z0-9_])
%token as           (?i)AS(?![a-zA-Z0-9_])
%token desc         (?i)DESC(?![a-zA-Z0-9_])
%token by           (?i)BY(?![a-zA-Z0-9_])
%token nulls        (?i)NULLS(?![a-zA-Z0-9_])
%token auto_increment (?i)AUTO_INCREMENT(?![a-zA-Z0-9_])
%token identity     (?i)IDENTITY(?![a-zA-Z0-9_])
%token serial       (?i)SERIAL(?![a-zA-Z0-9_])
%token generated    (?i)GENERATED(?![a-zA-Z0-9_])
%token always       (?i)ALWAYS(?![a-zA-Z0-9_])
%token stored       (?i)STORED(?![a-zA-Z0-9_])
%token virtual      (?i)VIRTUAL(?![a-zA-Z0-9_])

// =============================================================================
// KEYWORDS - LOGICAL OPERATORS
// =============================================================================
%token and          (?i)AND(?![a-zA-Z0-9_])
%token or           (?i)OR(?![a-zA-Z0-9_])
%token not          (?i)NOT(?![a-zA-Z0-9_])
%token xor          (?i)XOR(?![a-zA-Z0-9_])

// =============================================================================
// KEYWORDS - COMPARISON OPERATORS
// =============================================================================
// IMPORTANT: 'inner', 'into', 'intersect', etc. must come BEFORE 'in'
// because 'IN' would match as prefix of 'INNER' otherwise
%token exists       (?i)EXISTS(?![a-zA-Z0-9_])
%token between      (?i)BETWEEN(?![a-zA-Z0-9_])
%token like         (?i)LIKE(?![a-zA-Z0-9_])
%token ilike        (?i)ILIKE(?![a-zA-Z0-9_])
%token glob         (?i)GLOB(?![a-zA-Z0-9_])
%token regexp       (?i)REGEXP(?![a-zA-Z0-9_])
%token rlike        (?i)RLIKE(?![a-zA-Z0-9_])
%token match        (?i)MATCH(?![a-zA-Z0-9_])
%token contains     (?i)CONTAINS(?![a-zA-Z0-9_])
%token is           (?i)IS(?![a-zA-Z0-9_])
%token any          (?i)ANY(?![a-zA-Z0-9_])
%token some         (?i)SOME(?![a-zA-Z0-9_])
%token similar      (?i)SIMILAR(?![a-zA-Z0-9_])
%token escape       (?i)ESCAPE(?![a-zA-Z0-9_])
%token to           (?i)TO(?![a-zA-Z0-9_])

// =============================================================================
// KEYWORDS - JOINS (case-insensitive)
// =============================================================================
%token join         (?i)JOIN(?![a-zA-Z0-9_])
// inner and in moved to PREFIX PRIORITY section
%token outer        (?i)OUTER(?![a-zA-Z0-9_])
%token left         (?i)LEFT(?![a-zA-Z0-9_])
%token right        (?i)RIGHT(?![a-zA-Z0-9_])
%token full         (?i)FULL(?![a-zA-Z0-9_])
%token cross        (?i)CROSS(?![a-zA-Z0-9_])
%token natural      (?i)NATURAL(?![a-zA-Z0-9_])
%token on           (?i)ON(?![a-zA-Z0-9_])
%token using        (?i)USING(?![a-zA-Z0-9_])
%token straight_join (?i)STRAIGHT_JOIN(?![a-zA-Z0-9_])

// =============================================================================
// KEYWORDS - SET OPERATIONS
// =============================================================================
%token union        (?i)UNION(?![a-zA-Z0-9_])
// intersect moved to PREFIX PRIORITY section
%token except       (?i)EXCEPT(?![a-zA-Z0-9_])
%token minus        (?i)MINUS(?![a-zA-Z0-9_])

// =============================================================================
// KEYWORDS - CASE
// =============================================================================
%token case         (?i)CASE(?![a-zA-Z0-9_])
%token when         (?i)WHEN(?![a-zA-Z0-9_])
%token then         (?i)THEN(?![a-zA-Z0-9_])
%token else         (?i)ELSE(?![a-zA-Z0-9_])
%token end          (?i)END(?![a-zA-Z0-9_])
%token elseif       (?i)ELSEIF(?![a-zA-Z0-9_])
%token elsif        (?i)ELSIF(?![a-zA-Z0-9_])

// =============================================================================
// KEYWORDS - NULL
// =============================================================================
%token null         (?i)NULL(?![a-zA-Z0-9_])
%token isnull       (?i)ISNULL(?![a-zA-Z0-9_])
%token notnull      (?i)NOTNULL(?![a-zA-Z0-9_])

// =============================================================================
// KEYWORDS - BOOLEAN
// =============================================================================
%token true         (?i)TRUE(?![a-zA-Z0-9_])
%token false        (?i)FALSE(?![a-zA-Z0-9_])
%token unknown      (?i)UNKNOWN(?![a-zA-Z0-9_])

// =============================================================================
// KEYWORDS - CAST/CONVERT
// =============================================================================
%token cast         (?i)CAST(?![a-zA-Z0-9_])
%token convert      (?i)CONVERT(?![a-zA-Z0-9_])
%token try_cast     (?i)TRY_CAST(?![a-zA-Z0-9_])
%token try_convert  (?i)TRY_CONVERT(?![a-zA-Z0-9_])

// =============================================================================
// KEYWORDS - WINDOW FUNCTIONS
// =============================================================================
%token over         (?i)OVER(?![a-zA-Z0-9_])
%token partition    (?i)PARTITION(?![a-zA-Z0-9_])
%token window       (?i)WINDOW(?![a-zA-Z0-9_])
%token range        (?i)RANGE(?![a-zA-Z0-9_])
%token unbounded    (?i)UNBOUNDED(?![a-zA-Z0-9_])
%token preceding    (?i)PRECEDING(?![a-zA-Z0-9_])
%token following    (?i)FOLLOWING(?![a-zA-Z0-9_])
%token current      (?i)CURRENT(?![a-zA-Z0-9_])
%token row          (?i)ROW(?![a-zA-Z0-9_])
%token groups       (?i)GROUPS(?![a-zA-Z0-9_])
%token exclude      (?i)EXCLUDE(?![a-zA-Z0-9_])
%token ties         (?i)TIES(?![a-zA-Z0-9_])
%token no           (?i)NO(?![a-zA-Z0-9_])
%token others       (?i)OTHERS(?![a-zA-Z0-9_])

// =============================================================================
// KEYWORDS - CONSTRAINTS
// =============================================================================
%token primary      (?i)PRIMARY(?![a-zA-Z0-9_])
%token foreign      (?i)FOREIGN(?![a-zA-Z0-9_])
%token key          (?i)KEY(?![a-zA-Z0-9_])
%token references   (?i)REFERENCES(?![a-zA-Z0-9_])
%token unique       (?i)UNIQUE(?![a-zA-Z0-9_])
%token check        (?i)CHECK(?![a-zA-Z0-9_])
%token default      (?i)DEFAULT(?![a-zA-Z0-9_])
%token constraint   (?i)CONSTRAINT(?![a-zA-Z0-9_])
%token unsigned     (?i)UNSIGNED(?![a-zA-Z0-9_])
%token zerofill     (?i)ZEROFILL(?![a-zA-Z0-9_])
%token binary       (?i)BINARY(?![a-zA-Z0-9_])
%token collate      (?i)COLLATE(?![a-zA-Z0-9_])

// =============================================================================
// KEYWORDS - CONFLICT RESOLUTION (SQLite/PostgreSQL/MySQL)
// =============================================================================
%token ignore       (?i)IGNORE(?![a-zA-Z0-9_])
%token conflict     (?i)CONFLICT(?![a-zA-Z0-9_])
%token duplicate    (?i)DUPLICATE(?![a-zA-Z0-9_])
%token nothing      (?i)NOTHING(?![a-zA-Z0-9_])
%token abort        (?i)ABORT(?![a-zA-Z0-9_])
%token fail         (?i)FAIL(?![a-zA-Z0-9_])
%token rollback     (?i)ROLLBACK(?![a-zA-Z0-9_])

// =============================================================================
// KEYWORDS - LOCKING
// =============================================================================
%token for          (?i)FOR(?![a-zA-Z0-9_])
%token nowait       (?i)NOWAIT(?![a-zA-Z0-9_])
%token skip_kw      (?i)SKIP(?![a-zA-Z0-9_])
%token locked       (?i)LOCKED(?![a-zA-Z0-9_])
%token share        (?i)SHARE(?![a-zA-Z0-9_])
%token wait         (?i)WAIT(?![a-zA-Z0-9_])

// =============================================================================
// KEYWORDS - TRANSACTIONS
// =============================================================================
%token begin        (?i)BEGIN(?![a-zA-Z0-9_])
%token start        (?i)START(?![a-zA-Z0-9_])
%token transaction  (?i)TRANSACTION(?![a-zA-Z0-9_])
%token commit       (?i)COMMIT(?![a-zA-Z0-9_])
%token savepoint    (?i)SAVEPOINT(?![a-zA-Z0-9_])
%token release      (?i)RELEASE(?![a-zA-Z0-9_])
%token work         (?i)WORK(?![a-zA-Z0-9_])

// =============================================================================
// KEYWORDS - DATA TYPES
// =============================================================================
// Numeric types
// token int          INT (moved to PREFIX PRIORITY section)
// token integer      INTEGER (moved to PREFIX PRIORITY section)
%token smallint     (?i)SMALLINT(?![a-zA-Z0-9_])
%token bigint       (?i)BIGINT(?![a-zA-Z0-9_])
%token tinyint      (?i)TINYINT(?![a-zA-Z0-9_])
%token mediumint    (?i)MEDIUMINT(?![a-zA-Z0-9_])

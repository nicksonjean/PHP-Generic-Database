// token interval     INTERVAL (moved to PREFIX PRIORITY section)
%token smalldatetime (?i)SMALLDATETIME(?![a-zA-Z0-9_])
%token datetimeoffset (?i)DATETIMEOFFSET(?![a-zA-Z0-9_])


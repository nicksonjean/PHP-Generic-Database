// Geometric/Special types
%token geometry     (?i)GEOMETRY(?![a-zA-Z0-9_])
%token geography    (?i)GEOGRAPHY(?![a-zA-Z0-9_])
%token point        (?i)POINT(?![a-zA-Z0-9_])
%token linestring   (?i)LINESTRING(?![a-zA-Z0-9_])

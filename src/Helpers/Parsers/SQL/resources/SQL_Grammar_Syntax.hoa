%token mediumblob   (?i)MEDIUMBLOB(?![a-zA-Z0-9_])
%token longblob     (?i)LONGBLOB(?![a-zA-Z0-9_])
%token bytea        (?i)BYTEA(?![a-zA-Z0-9_])
%token varbinary    (?i)VARBINARY(?![a-zA-Z0-9_])
%token image        (?i)IMAGE(?![a-zA-Z0-9_])
%token raw          (?i)RAW(?![a-zA-Z0-9_])
